{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ScisoNomics",
  "version": "3.2.0",
  "identifier": "com.scisonomics.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://127.0.0.1:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ScisoNomics",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' blob:; connect-src 'self' http://127.0.0.1:8000 http://127.0.0.1:* http://localhost:* https://scisonomics-production-d8a3.up.railway.app; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "targets": "all",
    "homepage": "https://github.com/iante/scisonomics",
    "copyright": "Copyright © 2026 ScisoNomics",
    "category": "Finance",
    "shortDescription": "Gestión financiera personal local-first.",
    "longDescription": "ScisoNomics es una aplicación desktop local-first para gestionar finanzas personales, con datos locales, cuentas opcionales y sincronización cloud.",
    "externalBin": [
      "binaries/scisonomics-backend"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "nsis-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "startMenuFolder": "ScisoNomics",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
