{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ScisoNomics",
  "version": "3.0.0",
  "identifier": "com.scisonomics.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://127.0.0.1:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ScisoNomics",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "ScisoNomics",
    "homepage": "https://github.com/iante/scisonomics",
    "copyright": "Copyright © 2026 ScisoNomics",
    "category": "Finance",
    "shortDescription": "Gestion financiera personal local-first.",
    "longDescription": "ScisoNomics es una aplicacion desktop local-first para gestionar finanzas personales, con datos locales, cuentas opcionales y sincronizacion cloud.",
    "externalBin": [
      "binaries/scisonomics-backend"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "nsis-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "startMenuFolder": "ScisoNomics",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}

