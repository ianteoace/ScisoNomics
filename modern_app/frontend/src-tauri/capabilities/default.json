{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/ianteoace/scisonomics/**" },
        { "url": "https://scisonomics-production-d8a3.up.railway.app/**" },
        { "url": "http://127.0.0.1:9000/**" },
        { "url": "http://localhost:9000/**" }
      ]
    }
  ]
}
