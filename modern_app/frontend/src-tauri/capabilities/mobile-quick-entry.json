{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile-quick-entry",
  "description": "Accesos rápidos Android: navegación y solicitud explícita de tiles.",
  "windows": ["main"],
  "platforms": ["android"],
  "permissions": [
    "quick-entry:allow-peek-pending",
    "quick-entry:allow-consume-pending",
