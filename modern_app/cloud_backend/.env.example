SCISONOMICS_ENV=development
SCISONOMICS_CLOUD_DATABASE_URL=sqlite:///./modern_app/cloud_backend/scisonomics_cloud_dev.db
SCISONOMICS_JWT_SECRET=change-me-in-development
SCISONOMICS_ENTITLEMENTS_PRIVATE_KEY_FILE=C:/Users/USUARIO/.scisonomics-secrets/entitlements_private.pem
SCISONOMICS_ENTITLEMENTS_EXPIRE_SECONDS=86400
SCISONOMICS_ACCESS_TOKEN_EXPIRE_MINUTES=1440
SCISONOMICS_DEVICE_VERIFICATION_MODE=off
SCISONOMICS_DB_MIGRATION_LOCK_TIMEOUT_MS=15000
SCISONOMICS_DB_MIGRATION_STATEMENT_TIMEOUT_MS=120000
SCISONOMICS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
SCISONOMICS_GOOGLE_CLIENT_ID=
SCISONOMICS_GOOGLE_CLIENT_SECRET=
SCISONOMICS_GOOGLE_REDIRECT_URI=http://127.0.0.1:9000/auth/google/callback
SCISONOMICS_EMAIL_PROVIDER=console
SCISONOMICS_EMAIL_FROM=
SCISONOMICS_EMAIL_VERIFICATION_TTL_MINUTES=10
SCISONOMICS_EMAIL_RESEND_SECONDS=60
SCISONOMICS_EMAIL_MAX_RESENDS_PER_HOUR=5
SCISONOMICS_EMAIL_DEV_LOG_CODES=false
SCISONOMICS_SMTP_HOST=
SCISONOMICS_SMTP_PORT=587
SCISONOMICS_SMTP_USERNAME=
SCISONOMICS_SMTP_PASSWORD=
SCISONOMICS_SMTP_USE_TLS=true

# Produccion Railway/PostgreSQL:
# SCISONOMICS_ENV=production
# SCISONOMICS_JWT_SECRET=GENERAR_SECRET_SEGURO
# SCISONOMICS_DEVICE_VERIFICATION_MODE=off
# SCISONOMICS_ENTITLEMENTS_PRIVATE_KEY=CLAVE_PRIVADA_RSA_PEM_CON_SALTOS_ESCAPADOS
# DATABASE_URL=postgresql://...
# Para app desktop se puede ampliar segun el origen final; evitar "*" en produccion web.
# SCISONOMICS_ALLOWED_ORIGINS=https://TU_FRONTEND
# SCISONOMICS_GOOGLE_CLIENT_ID=...
# SCISONOMICS_GOOGLE_CLIENT_SECRET=...
# SCISONOMICS_GOOGLE_REDIRECT_URI=https://TU_BACKEND/auth/google/callback
# SCISONOMICS_EMAIL_PROVIDER=smtp
# SCISONOMICS_EMAIL_FROM="ScisoNomics <no-reply@tudominio.com>"
# SCISONOMICS_SMTP_HOST=...
# SCISONOMICS_SMTP_USERNAME=...
# SCISONOMICS_SMTP_PASSWORD=...
